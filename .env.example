# ---------------------------------------------------------------------------
# Brand My Daytona — environment template
#
# Copy to .env.local for development. Never commit a filled-in copy: .env and
# .env.local are gitignored for this reason.
# ---------------------------------------------------------------------------

# Data store.
#   memory   — in-process, zero setup. Development and demos ONLY: bids are not
#              saved, and each server instance sees a different set of them.
#   postgres — production. Requires DATABASE_URL.
DATA_DRIVER=memory

# Postgres connection string. Use a POOLED endpoint on serverless hosting
# (Supabase pgbouncer, Neon pooler, RDS Proxy) or you will exhaust connections.
# DATABASE_URL=postgresql://user:password@host:5432/branding?sslmode=require

# Shared bearer token for /api/v1/admin/* and the /admin console.
# Minimum 32 characters. Generate with:  openssl rand -base64 48
# Until this is set the admin API rejects every request (fails closed).
# ADMIN_API_TOKEN=

# Per-deployment salt for hashing bidder IP addresses. Set this explicitly in
# production: if it is absent a random salt is generated per process, which
# makes stored hashes incomparable across restarts and instances.
# Generate with:  openssl rand -hex 32
# IP_HASH_SALT=

# Auction window, ISO 8601 with an explicit timezone. CHANGE BOTH before launch.
AUCTION_OPENS_AT=2026-09-01T09:00:00.000Z
AUCTION_CLOSES_AT=2026-11-30T20:00:00.000Z

# Money and formatting. CURRENCY is ISO 4217 and drives every price on the site;
# reserves in src/lib/domain/panels.ts are plain numbers, so switching currency
# does NOT convert them — review the reserves when you change this.
CURRENCY=GBP
LOCALE=en-GB

# Bid submissions allowed per client per window.
BID_RATE_LIMIT=5
BID_RATE_WINDOW_SECONDS=300

# debug | info | warn | error
LOG_LEVEL=info
